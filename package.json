{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@portfolio/web --env-mode=loose",
    "build": "turbo run build --filter=@portfolio/web",
    "build:all": "turbo run build",
    "preview": "turbo run preview --filter=@portfolio/web --env-mode=loose",
    "dev:ssh": "pnpm --filter @portfolio/ssh dev",
    "dev:ssh:drafts": "pnpm --filter @portfolio/ssh dev:drafts",
    "build:ssh": "turbo run build --filter=@portfolio/ssh",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "turbo run lint format:check typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "turbo": "2.11.6",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.0"
}
