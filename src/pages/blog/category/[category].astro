---
import H1 from "../../../components/h1.astro";
import { formatDate } from "../../../lib/utils";
import InfoLayout from "../../../layouts/InfoLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const categoryToSlug = (category: string) => category.toLowerCase().replaceAll(" ", "-");
    const articles = await getCollection("articles");
    const categories = [...new Set(articles.map((article) => article.data.category))];

    return categories.map((category) => ({
        params: { category: categoryToSlug(category) },
        props: { category },
    }));
}

const articles = await getCollection("articles");
const categories = [...new Set(articles.map((article) => article.data.category))];
const { category: selectedCategory } = Astro.props;
const categoryToSlug = (category: string) => category.toLowerCase().replaceAll(" ", "-");

const filteredArticles = articles.filter((article) => article.data.category === selectedCategory);
---

<InfoLayout title={`${selectedCategory} Articles`}>
    <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
        <H1> Blog </H1>

        <ul class="mt-4 flex items-center gap-4">
            <li>
                <a href="/blog" class="w-fit px-4 py-1 text-sm bg-transparent rounded-full transition-all duration-300 ease-in-out text-zinc-400 hover:text-zinc-300">
                    All
                </a>
            </li>

            {
                categories.map((category) => (
                    <li>
                        <a
                            href={`/blog/category/${categoryToSlug(category)}`}
                            class={`w-fit px-4 py-1 text-sm bg-transparent rounded-full transition-all duration-300 ease-in-out ${
                                category === selectedCategory ? "text-white bg-zinc-100/20 outline-2 outline-offset-2 outline-zinc-100/20" : "text-zinc-400 hover:text-zinc-200"
                            }`}
                        >
                            {category}
                        </a>
                    </li>
                ))
            }
        </ul>

        <ul class="mt-4 space-y-6">
            {
                filteredArticles.map((article) => (
                    <li>
                        <a
                            class="space-y-1 group"
                            href={`/blog/${article.data.slug}`}
                        >
                            <h2 class="text-xl xl:text-2xl text-zinc-300 group-hover:text-white text-balance font-medium underline group-hover:underline-offset-2 decoration-transparent group-hover:decoration-zinc-500">
                                {article.data.title}
                            </h2>
                            <p class="text-base text-zinc-400">
                                {article.data.snippet}
                            </p>
                            <p class="text-sm text-zinc-500">
                                {formatDate(article.data.pubDate)} &middot;{" "}
                                {article.data.readingDuration} min read
                            </p>
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</InfoLayout>
