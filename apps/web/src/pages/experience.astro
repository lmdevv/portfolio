---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import { experiences } from "@portfolio/content";
---

<InfoLayout>
  <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
    <H1>Experience</H1>

    <div class="mt-4 sm:mt-12 space-y-12">
      {experiences.map((exp) => (
        <div class="group">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-2">
            <div>
              <h2 class="text-xl text-zinc-100 font-medium">{exp.position}</h2>
              <p class="text-zinc-400">{exp.company}</p>
            </div>
            <div class="text-right">
              <p class="text-sm text-zinc-500">{exp.period}</p>
              <p class="text-sm text-zinc-500">{exp.location}</p>
            </div>
          </div>

          <p class="text-zinc-400 mb-3">{exp.description}</p>

          <ul class="space-y-1 mb-3">
            {exp.responsibilities.map((resp) => (
              <li class="text-sm text-zinc-400 flex items-start gap-2">
                <span class="text-zinc-500 mt-1.5">•</span>
                <span>{resp}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-2">
            {exp.technologies.map((tech) => (
              <span class="text-xs px-2 py-1 rounded-full bg-zinc-800 text-zinc-400">{tech}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</InfoLayout>