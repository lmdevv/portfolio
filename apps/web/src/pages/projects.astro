---
import H1 from "../components/h1.astro";
import InfoLayout from "../layouts/InfoLayout.astro";
import { IconBrandGithub, IconBuildingStore, IconWorldWww } from "@tabler/icons-react";
import { projects, type ProjectLinkKind } from "@portfolio/content";

const homepageIcons: Record<ProjectLinkKind, typeof IconWorldWww> = {
     web: IconWorldWww,
     github: IconBrandGithub,
     store: IconBuildingStore,
};
---

<InfoLayout>
     <div class="p-4 sm:pt-8 sm:px-12 pb-20 min-h-dvh">
          <H1> Projects </H1>

          <ul class="mt-4 sm:mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
               {projects.map((project) => (
                    <li class="group relative p-4 rounded-lg border border-zinc-800 hover:border-zinc-700 transition-colors">
                         <a href={project.url} target="_blank" rel="noopener noreferrer" class="absolute inset-0 rounded-lg" aria-label={`Open ${project.title} GitHub repository`}>
                              <span class="sr-only">Open {project.title} GitHub repository</span>
                         </a>
                         <div class="relative z-10 flex items-start justify-between mb-2 pointer-events-none">
                              <h2 class="text-lg text-zinc-100 font-medium group-hover:text-white">
                                   {project.title}
                              </h2>
                              {project.homepage && (() => {
                                   const { url, label, kind } = project.homepage;
                                   const HomepageIcon = homepageIcons[kind];

                                   return (
                                        <a href={url} target="_blank" rel="noopener noreferrer" class="pointer-events-auto rounded-md p-1 text-zinc-500 transition-colors hover:text-zinc-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-zinc-300" aria-label={label} title={label}>
                                             <HomepageIcon size={20} stroke={1.8} aria-hidden="true" />
                                             <span class="sr-only">{label}</span>
                                        </a>
                                   );
                              })()}
                         </div>
                         <p class="relative z-10 pointer-events-none text-sm text-zinc-400 text-balance mb-3">{project.description}</p>
                         <div class="relative z-10 pointer-events-none flex flex-wrap gap-2 mb-2">
                              {project.languages.map((lang) => (
                                    <span class="text-xs px-2 py-1 rounded-full bg-zinc-800 text-zinc-400">{lang}</span>
                              ))}
                         </div>
                         {project.topics.length > 0 && (
                              <div class="relative z-10 pointer-events-none flex flex-wrap gap-2">
                                   {project.topics.map((topic) => (
                                         <span class="text-xs text-zinc-500">#{topic}</span>
                                   ))}
                              </div>
                         )}
                    </li>
               ))}
          </ul>
     </div>
</InfoLayout>
